#include <stdio.h>
int prime(int a){
    if (a==1)
        return 0;
    for(int i=2;i*i<=a;i++){
        if(a%i==0)
            return 0;
    }
    return 1;
}
int main() {
    int s[20];
    int a, b, n;
    scanf("%d",&n);
    for (int i=0;i<n;i++){
        scanf("%d",&s[i]);
    }
    for(int i=0;i<n;i++){
        if(prime(s[i]))
            printf("Yes\n");
        else printf("No\n");
    }
 
    return 0;
}
